"""Live benchmark against the deployed Railway endpoint (read-only QA)."""
from __future__ import annotations

import json
import time
import urllib.request

BASE = "https://gridwise-production-f810.up.railway.app"
OPT_URL = f"{BASE}/optimize-energy"

import os, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from conftest import make_scenario  # noqa: E402

CASES = [
    ("SAMPLE-01",
     ["Expect an 80% reduction in rooftop solar during the 1-3 PM window.",
      "The campus will host a seminar today."],
     ["solar_reduction", "no_op"]),
    ("SAMPLE-02",
     ["Battery charging is not allowed from 2 PM to 4 PM."],
     ["no_charge_window"]),
    ("SAMPLE-03",
     ["Keep the battery reserve at least 150 kWh from 6 PM to 9 PM."],
     ["minimum_battery_reserve"]),
    ("SAMPLE-04",
     ["Do not discharge the battery between 6 PM and 8 PM."],
     ["no_discharge_window"]),
    ("SAMPLE-05",
     ["Grid import must not exceed 120 kWh from 6 PM to 8 PM."],
     ["max_grid_window"]),
    ("SAMPLE-06",
     ["Expect an 80% reduction in rooftop solar during the 1-3 PM window.",
      "Battery charging is not allowed from 2 PM to 4 PM.",
      "The library will be closed today."],
     ["solar_reduction", "no_charge_window", "no_op"]),
    ("SAMPLE-07",
     ["Keep the battery reserve at least 150 kWh from 6 PM to 9 PM.",
      "Grid import must not exceed 120 kWh from 6 PM to 8 PM."],
     ["minimum_battery_reserve", "max_grid_window"]),
    ("SAMPLE-08",
     ["Battery charging is not allowed from 2 PM to 4 PM.",
      "Do not discharge the battery between 6 PM and 8 PM."],
     ["no_charge_window", "no_discharge_window"]),
    ("SAMPLE-09",
     ["PV production will drop to about 20% between 13:00 and 15:00.",
      "The cafeteria will serve pasta today."],
     ["solar_reduction", "no_op"]),
    ("SAMPLE-10",
     ["Keep the battery reserve at least 150 kWh from 6 PM to 9 PM.",
      "Grid import must not exceed 120 kWh from 6 PM to 8 PM.",
      "The campus will host a seminar today."],
     ["minimum_battery_reserve", "max_grid_window", "no_op"]),
]


def post(payload, timeout=120):
    data = json.dumps(payload).encode()
    req = urllib.request.Request(OPT_URL, data=data,
                                 headers={"Content-Type": "application/json"},
                                 method="POST")
    t0 = time.perf_counter()
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            body = r.read().decode()
            dt = time.perf_counter() - t0
            return r.status, body, dt, None
    except Exception as e:  # noqa: BLE001
        dt = time.perf_counter() - t0
        code = getattr(e, "code", None)
        try:
            eb = e.read().decode()[:300] if hasattr(e, "read") else ""
        except Exception:  # noqa: BLE001
            eb = ""
        return code or "ERR", eb, dt, str(e)[:200]


results = []
t_all0 = time.perf_counter()
for cid, notes, expected in CASES:
    payload = make_scenario(notes=notes, scenario_id=cid)
    status, body, dt, err = post(payload)
    rec = {"id": cid, "http": status, "time": dt, "expected": expected,
           "error": err, "cost": None, "peak": None, "got": None,
           "final_bat": None, "pass": False, "raw": body[:2000]}
    if status == 200:
        try:
            b = json.loads(body)
            rec["got"] = [e["directive_type"] for e in b["directive_interpretation"]]
            rec["cost"] = b["total_cost_bdt"]
            rec["peak"] = b["peak_grid_kwh"]
            rec["final_bat"] = b["hourly_plan"][-1]["battery_energy_after_kwh"]
            rec["nhours"] = len(b["hourly_plan"])
            rec["pass"] = (rec["got"] == expected)
            rec["scenario_ok"] = (b.get("scenario_id") == cid)
        except Exception as e:  # noqa: BLE001
            rec["error"] = f"parse: {e}"
    results.append(rec)
    print(f"{cid} http={status} t={dt:.3f}s pass={rec['pass']} cost={rec['cost']} peak={rec['peak']}", flush=True)

with open("_live_results.json", "w") as f:
    json.dump({"base": BASE, "results": results,
               "total": time.perf_counter() - t_all0}, f, indent=1)
print("saved _live_results.json")