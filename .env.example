# GridWise environment configuration.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# --- LLM provider -----------------------------------------------------------
# Options: "openai" | "gemini" | "none"
#
# Google Gemini is configured below. The dedicated GeminiProvider is used when
# LLM_PROVIDER=gemini AND LLM_API_KEY is set.
LLM_PROVIDER=gemini

# API key for the selected provider. NEVER hardcode a real key here or in
# source code — provide it via the environment (a local, git-ignored .env file
# or the shell). .env is already in .gitignore.
LLM_API_KEY=

# Model name. Leave blank to use the provider default:
#   openai -> gpt-4o-mini
#   gemini -> gemini-1.5-flash
LLM_MODEL=gemini-1.5-flash

# Optional custom base URL for OpenAI-compatible endpoints
# (e.g. Azure OpenAI, OpenRouter, a local server). Leave blank for default.
LLM_BASE_URL=

# Sampling temperature. Keep 0.0 for deterministic interpretation.
LLM_TEMPERATURE=0.0

# Request timeout in seconds.
LLM_TIMEOUT_SECONDS=30

# --- Fallback ---------------------------------------------------------------
# When "true", an offline heuristic fallback is used if no LLM key is set.
# This is for LOCAL DEVELOPMENT ONLY. Set to "false" in judge/production so
# the service never pretends real LLM interpretation happened.
ALLOW_LLM_FALLBACK=true

# --- Server -----------------------------------------------------------------
# Port used when running `python -m backend.main` locally.
PORT=8000